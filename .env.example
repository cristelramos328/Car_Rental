# Copy this file to .env and configure your SMTP account.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-address@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_ENCRYPTION=tls
SMTP_FROM_EMAIL=your-address@gmail.com
SMTP_FROM_NAME="Vehicle Rental Management System"
PAYMONGO_PUBLIC_KEY=pk_test_replace_with_your_public_key
PAYMONGO_SECRET_KEY=sk_test_replace_with_your_secret_key
PAYMONGO_WEBHOOK_SECRET=replace_with_your_webhook_signing_secret
